RUN_ENVIRONMENT=prod
TZ=UTC

LOG__LEVEL=INFO
LOG__LEVEL_EXTERNAL=WARNING
LOG__SHOW_TIME=false
LOG__CONSOLE_WIDTH=150

DB__HOST=postgres
DB__PORT=5432
DB__USER=hubmi
DB__PASSWORD=hubmi
DB__DB_NAME=hubmi
DB__SCRIPTS_CONNECTION_URL=postgresql://hubmi:hubmi@localhost:5432/hubmi

API__HOST=0.0.0.0
API__PORT=8080
API__WORKERS=1
API__DOCS=false

AUTH__SECRET=
AUTH__SESSION_DAYS=30

LLM__MODEL=google-gla:gemini-2.5-flash
LLM__GEMINI_API_KEY=
