RUN_ENVIRONMENT=prod
TZ=UTC

LOG__LEVEL=INFO
LOG__LEVEL_EXTERNAL=WARNING
LOG__SHOW_TIME=false
LOG__CONSOLE_WIDTH=150

DB__HOST=postgres
DB__PORT=5432
DB__USER=hubmi
DB__PASSWORD=hubmi
DB__DB_NAME=hubmi
DB__SCRIPTS_CONNECTION_URL=postgresql://hubmi:hubmi@localhost:5432/hubmi

API__HOST=0.0.0.0
API__PORT=8080
API__WORKERS=1
API__DOCS=false

AUTH__SECRET=
AUTH__SESSION_HOURS=12

MAILER__RESEND_API_KEY=
MAILER__SENDER=HubMi <hubmi@kotikot.com>
MAILER__REPLY_TO=
MAILER__STAFF_EMAIL=
MAILER__STAFF_DIGEST_SECONDS=600
MAILER__PUBLIC_URL=https://hubmi.qwontie.dev

LLM__MODEL=google-gla:gemini-2.5-flash
LLM__GEMINI_API_KEY=
LLM__DAILY_BUDGET_USD=5
LLM__BATCH_DAILY_BUDGET_USD=8

SCHEDULE__ENABLED=true
SCHEDULE__AT=03:30
SCHEDULE__TIMEZONE=Europe/Warsaw
